{
  "outputDirectory": "dist",
  "functions": {
    "api/productos.js": {
      "includeFiles": "{lib/**,costo-web/src/data.json}"
    },
    "api/calcular.js": {
      "includeFiles": "{lib/**,costo-web/src/data.json,costo-web/src/lib/calcular.js}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
